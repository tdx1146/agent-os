# =============================================================
# Agent OS 环境变量模板（Phase 6 部署一致性 — 单一配置清单）
# =============================================================
# 用法:
#   cp env.template env.local   # 填真实值
#   start_all.sh 会自动加载 env.local（不存在则用内置默认值）
#
# 各服务实际加载点：
#   - sandglass_http_api (17333) : start_all.sh 导出 NEXSANDBASE_HOME/SANDGLASS_SOURCE
#   - LMS API (8190)             : start_all.sh source $LMS_HOME/.env（含密钥，不在本文件）
#   - glue_server (19000)        : 自身读 memory-integration-layer/.env
#   - iso-sand scheduler/consumer: iso-sand/start_*.sh（自含路径）
#   - verify_daemon              : start_all.sh 设置 cwd 即可（自含路径）
#   - shouji_memory_mcp 桥接     : OpenClaw MCP 注册（openclaw.json），可选 SHOUJI_MCP_URL
#
# 更新日期：2026-08-04（Phase 6）

# ── 沙漏（NexSandglass）──────────────────────────────────────────
# 断口①修复：sandglass_paths.py 的 _NB 取 NEXSANDBASE_HOME，未设则落到 ~/.neurobase（空）
# 真实数据目录：sandglass.txt / sandglass.db / shadow_sand.db / decision_particles.txt 所在
NEXSANDBASE_HOME="/vol2/1000/AI专用/所有自动化/轻如烟/sandglass"
# 沙漏源码目录（sandglass_vault/think/log/decision_particles 等模块）
SANDGLASS_SOURCE="/vol2/1000/AI专用/所有自动化/轻如烟/sandglass_source"
# 沙漏 HTTP API 端口（本机 17333，手机网关 NAS_API 指向这里）
SANDGLASS_API_PORT="17333"
# facts.dict.md 事实字典（17333 facts_lookup 读此路径，从 scripts/facts.dict.md 复制）
FACTS_DICT_PATH="/vol1/@apphome/trim.openclaw/data/workspace/memory/facts.dict.md"

# ── 活体记忆系统 LMS ─────────────────────────────────────────────
# 启动时 source $LMS_HOME/.env（含 DEEPSEEK_API_KEY 等密钥，不在此模板）
LMS_HOME="/vol2/1000/AI专用/living-memory-system-cloud"
LMS_URL="http://localhost:8190"
LMS_API_PORT="8190"
# 嵌入模式：cloud（手机 Ollama bge-m3）；HF 不可达，勿用 local
LMS_EMBEDDER="cloud"
# 手机 Ollama 嵌入端点：LAN 直连 192.168.0.103:11435（快，0.03s）
# 备选域名隧道 https://11435.tdx1146.cc/v1/embeddings（可用但慢 ~1.5s）
LMS_CLOUD_EMBED_URL="http://192.168.0.103:11435/v1/embeddings"
LMS_CLOUD_EMBED_MODEL="bge-m3"
LMS_CLOUD_EMBED_DIM="1024"
LMS_SNAPSHOT_DIR="/vol2/1000/AI专用/living-memory-system-cloud/snapshots"
# 做梦频率（Phase 5 已调低：空闲 300s 后触发）
DREAM_IDLE_THRESHOLD="300"
DREAM_STEPS="30"
DREAM_CHECK_INTERVAL="10"

# ── 胶水层 glue_server ───────────────────────────────────────────
# 启动时读 memory-integration-layer/.env（SANDGLASS_SOURCE/NEXSANDBASE_HOME/LMS_URL/VECTOR_URL）
GLUE_HOME="/vol2/1000/AI专用/memory-integration-layer"
GLUE_PORT="19000"
VECTOR_URL="http://192.168.0.103:11435/v1/embeddings"

# ── iso-sand 事件总线（Agent OS 调度器+消费者）───────────────────
ISO_SAND_HOME="/vol2/1000/AI专用/Agent OS/iso-sand"
# 丰碑 audit 低频化（Phase 6）：audit.task_complete handler rate_limit=1800s（30min）

# ── 玄鉴 verify_daemon ───────────────────────────────────────────
VERIFY_HOME="/vol2/1000/AI专用/AgentOS-IsoSand/同构沙盘"
KERNEL_SPEC_DIR="/vol2/1000/AI专用/AgentOS-IsoSand/内核层规范"

# ── 手机记忆网关（shouji_memory_mcp 桥接，OpenClaw MCP 注册用）────
SHOUJI_MCP_URL="https://shouji.tdx1146.cc/tools"
SHOUJI_MCP_TIMEOUT="15"

# ── 运行目录 ─────────────────────────────────────────────────────
AGENT_OS_HOME="/vol2/1000/AI专用/Agent OS"
RUN_DIR="/vol2/1000/AI专用/Agent OS/run"
LOG_DIR="/vol2/1000/AI专用/Agent OS/logs"
