# =============================================================
# Agent OS 统一部署配置模板（2026-08-10 部署统一化重构）
# =============================================================
# 全体系唯一配置中心。以下脚本全部从这里读路径与端口，脚本内绝不硬编码绝对路径：
#   - stack_ctl.sh        （统一服务管理器：start/stop/status/doctor/setup…）
#   - start_all.sh / status_all.sh / stop_all.sh
#   - iso-sand/start_*.sh （事件总线调度器/消费者）
#   - 轻如烟/scripts/*.sh （health-check / health-loop / pulse-cron / watchdog…）
#   - living-memory-system-cloud/scripts/lms_ctl.sh、fix_pid_probe.sh
#
# 新机器部署步骤（详见 DEPLOY-GLOBAL.md）：
#   ① cp env.template env.local
#   ② 只改「A. 机器根变量」一节（其余全部自动派生）
#   ③ ./stack_ctl.sh doctor    # 全配置校验（路径/端口/依赖命令），全绿即就绪
#   ④ ./stack_ctl.sh start     # 一键启动全部服务
#
# 原则：
#   - 绝对路径只允许出现在本文件；脚本对缺失变量用「相对路径推导」兜底。
#   - 密钥不进本文件：LMS 密钥在 $LMS_HOME/.env，轻如烟密钥在 $LIGHT_HOME/scripts/.env。

# =============================================================
# A. 机器根变量 —— 新机器唯一需要改写的部分
# =============================================================
# Agent OS 仓库根（本文件所在目录）
AGENT_OS_HOME="/vol2/1000/AI专用/Agent OS"

# 轻如烟仓库根（所有自动化/轻如烟：scripts、sandglass、sandglass_source、memory）
LIGHT_HOME="/vol2/1000/AI专用/所有自动化/轻如烟"

# 活体记忆系统 LMS 仓库
LMS_HOME="/vol2/1000/AI专用/living-memory-system-cloud"

# 胶水层仓库
GLUE_HOME="/vol2/1000/AI专用/memory-integration-layer"

# 玄鉴同构沙盘（verify_daemon 所在）与内核层规范目录
VERIFY_HOME="/vol2/1000/AI专用/AgentOS-IsoSand/同构沙盘"
KERNEL_SPEC_DIR="/vol2/1000/AI专用/AgentOS-IsoSand/内核层规范"

# 事实字典文件（17333 facts_lookup 读取；可从 $LIGHT_HOME/scripts/facts.dict.md 复制）
FACTS_DICT_PATH="/vol1/@apphome/trim.openclaw/data/workspace/memory/facts.dict.md"

# 手机 Ollama 嵌入端点（LMS 用；HF 不可达，勿用 local）
LMS_CLOUD_EMBED_URL="http://192.168.0.103:11435/v1/embeddings"
LMS_CLOUD_EMBED_MODEL="bge-m3"
LMS_CLOUD_EMBED_DIM="1024"

# 胶水层向量端点（与 LMS 嵌入同源）
VECTOR_URL="http://192.168.0.103:11435/v1/embeddings"

# 手机记忆网关（OpenClaw MCP 桥接注册用）
SHOUJI_MCP_URL="https://shouji.tdx1146.cc/tools"
SHOUJI_MCP_TIMEOUT="15"

# 会话重置看门狗（session-reset-watchdog.py）：OpenClaw sessions 目录（机器相关）
RESET_WATCHDOG_SESSIONS_DIR="/vol1/@apphome/trim.openclaw/data/home/.openclaw/agents/main/sessions"

# =============================================================
# B. 端口 —— 服务监听端口，整体迁移时只需改这里
# =============================================================
SANDGLASS_API_PORT="17333"
LMS_API_PORT="8190"
GLUE_PORT="19000"
EDITOR_PORT="18888"

# =============================================================
# C. 派生路径 —— 由 A/B 自动计算，一般无需改动
# =============================================================
SANDGLASS_SOURCE="${LIGHT_HOME}/sandglass_source"
NEXSANDBASE_HOME="${LIGHT_HOME}/sandglass"
ISO_SAND_HOME="${AGENT_OS_HOME}/iso-sand"
EDITOR_HOME="${LIGHT_HOME}/scripts"
RUN_DIR="${AGENT_OS_HOME}/run"
LOG_DIR="${AGENT_OS_HOME}/logs"
LMS_SNAPSHOT_DIR="${LMS_HOME}/snapshots"
LMS_URL="http://localhost:${LMS_API_PORT}"
RESET_WATCHDOG_STATE_FILE="${LIGHT_HOME}/memory/reset-watchdog-state.json"
RESET_WATCHDOG_LOG_FILE="${LIGHT_HOME}/memory/reset-watchdog.log"

# =============================================================
# D. 服务参数 —— 会透传给各服务启动环境
# =============================================================
LMS_EMBEDDER="cloud"
DREAM_IDLE_THRESHOLD="300"
DREAM_STEPS="30"
DREAM_CHECK_INTERVAL="10"
