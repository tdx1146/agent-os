# ============================================================================
# Agent OS Docker 化 — 机器配置（路径 / 端口 / 运行模式）
# ----------------------------------------------------------------------------
# 用法: cp .env.example .env  然后按需修改
# 本文件不含密钥（密钥在 .env.local）。路径均为本机真实目录（bind mount）。
# 改动前必读 README.md：部分容器目标是【代码硬编码的镜像路径】，
# 宿主源路径不得随意改动，否则容器内找不到数据。
# ============================================================================

# ---------- 宿主端口映射（容器内固定 17333/8190/19000）----------
# 验证阶段（裸进程仍占用原端口）临时改 18190/18191/18192；
# 正式切换容器时恢复 17333/8190/19000（需先停裸进程）。
SANDGLASS_HOST_PORT=17333
LMS_HOST_PORT=8190
GLUE_HOST_PORT=19000

# ---------- 沙漏（path-mirror：容器内同一绝对路径）----------
# 警告：sandglass_http_api.py 硬编码这些绝对路径，源路径必须保持默认值
SANDBOX_DATA_DIR=/vol2/1000/AI专用/所有自动化/轻如烟/sandglass
SANDBOX_SOURCE_DIR=/vol2/1000/AI专用/所有自动化/轻如烟/sandglass_source
# 事实字典所在目录（facts.dict.md 所在目录，容器内镜像挂载只读）
FACTS_MEMORY_DIR=/vol1/@apphome/trim.openclaw/data/workspace/memory

# ---------- LMS ----------
LMS_HOME_DIR=/vol2/1000/AI专用/living-memory-system-cloud
# 快照目录（宿主真实 snapshots；验证阶段可指 verify-data/lms-snapshots）
LMS_SNAPSHOT_HOST=/vol2/1000/AI专用/living-memory-system-cloud/snapshots
# 记忆数据（self_voice/ archive/ control/；容器挂 /app/data）
LMS_DATA_HOST=/vol2/1000/AI专用/living-memory-system-cloud/data
# 审计日志（容器挂 /app/logs）
LMS_LOGS_HOST=/vol2/1000/AI专用/living-memory-system-cloud/logs
# HF/模型缓存（可选）
LMS_CACHE_HOST=/vol2/1000/AI专用/Agent OS/docker/data/lms-cache

# ---------- 胶水层（path-mirror）----------
GLUE_HOME_DIR=/vol2/1000/AI专用/memory-integration-layer

# ---------- iso-sand 事件总线 ----------
ISO_SAND_HOME_DIR=/vol2/1000/AI专用/Agent OS/iso-sand
# 数据目录：生产=真实 data/；沙箱验证=./verify-data/iso-sand-data
ISO_SAND_DATA_HOST=/vol2/1000/AI专用/Agent OS/iso-sand/data
# 任务配置：生产=/app/iso-sand/deploy/tasks.yaml；沙箱=/docker/iso-sand/tasks.scratch.yaml
ISO_SAND_TASKS_FILE=/app/iso-sand/deploy/tasks.yaml

# ---------- 玄鉴 verify_daemon（可选服务，profile: xuanjian）----------
VERIFY_HOME_DIR=/vol2/1000/AI专用/AgentOS-IsoSand/同构沙盘
KERNEL_SPEC_DIR=/vol2/1000/AI专用/AgentOS-IsoSand/内核层规范
# 数据目录：生产=真实 data/；沙箱验证=./verify-data/xuanjian-data
VERIFY_DATA_HOST=/vol2/1000/AI专用/AgentOS-IsoSand/同构沙盘/data
