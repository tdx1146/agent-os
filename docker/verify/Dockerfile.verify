# ============================================================================
# Agent OS Docker 化 — 玄鉴 verify_daemon（Phase 7，可选服务）
# ----------------------------------------------------------------------------
# 纯标准库守护进程（监控 operation_log.jsonl + PURPOSE.md 完整性）。
# path-mirror 挂载：项目根 ro + data 子目录 rw（默认宿主真实 data/，
# 沙箱验证时指向 verify-data/xuanjian-data/，避免与裸进程抢 pid/seek）。
# ============================================================================

FROM python:3.11-slim

LABEL org.opencontainers.image.title="agentos-verify" \
      org.opencontainers.image.description="玄鉴 verify_daemon（容器版，path-mirror 模式）" \
      org.opencontainers.image.version="1.0.0"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

CMD ["python", "/vol2/1000/AI专用/AgentOS-IsoSand/同构沙盘/src/verify_daemon.py"]
