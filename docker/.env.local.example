# ============================================================================
# Agent OS Docker 化 — 容器环境变量（密钥 + 运行配置）
# ----------------------------------------------------------------------------
# 用法: cp .env.local.example .env.local  然后填入真实值
# 警告: .env.local 含密钥（DEEPSEEK_API_KEY），已被 .gitignore 忽略，禁止提交。
#
# ⚠️ LAN 内网地址（如 192.168.0.103:11435）属于本机专属配置：
#    只在本地 .env.local 里填，绝不写入本模板 / compose / Dockerfile 默认值。
#    模板默认给隧道域名（公网可达，他机部署可直接用）。
#    ⚠️ 实测：域名+端口形式 http://11435.tdx1146.cc:11435 不通（隧道只放行 443），
#    容器网络务必用 https://11435.tdx1146.cc/v1/embeddings（443，已验证 200）。
# ============================================================================

# ---------- LLM（DeepSeek）----------
# 必填：LMS /chat、沙漏语义搜索、玄鉴校验会用到；留空则相关能力降级
DEEPSEEK_API_KEY=
# 备选 LLM Key（与 DEEPSEEK_API_KEY 等效回退）
LMS_LLM_API_KEY=
LMS_LLM_BASE_URL=https://api.deepseek.com/v1
LMS_LLM_MODEL=deepseek-chat

# ---------- 嵌入服务（感官层，cloud = 远端 OpenAI 兼容 /embeddings）----------
LMS_EMBEDDER=cloud
# 主嵌入地址 —— 默认给隧道域名（不写死 LAN 内网地址）：
#   · 本机部署：可改为 LAN 直连 http://<内网IP>:11435/v1/embeddings（更快）
#   · 他机/外网：保持隧道域名 https://11435.tdx1146.cc/v1/embeddings
LMS_CLOUD_EMBED_URL=https://11435.tdx1146.cc/v1/embeddings
# 备用嵌入地址（主 URL 失败自动切换；本机可把 LAN/隧道互为兜底）
LMS_CLOUD_EMBED_FALLBACK_URL=
LMS_CLOUD_EMBED_MODEL=bge-m3
LMS_CLOUD_EMBED_DIM=1024

# ---------- 服务监听（容器内固定值，与 compose 端口映射对应）----------
LMS_API_HOST=0.0.0.0
LMS_API_PORT=8190
# 快照目录（容器内路径，由 compose 挂载宿主真实 snapshots）
LMS_SNAPSHOT_DIR=/app/snapshots

# ---------- 管理面 lms-control（:8191，容器内互联）----------
LMS_CTRL_HOST=0.0.0.0
LMS_CTRL_PORT=8191
LMS_CTRL_API_BASE=http://lms-api:8190
# 控制面写端点 token（openssl rand -hex 32 生成；缺失 = 只读模式）
LMS_CONTROL_TOKEN=

# ---------- 胶水层向量服务（OpenAI 兼容 /embeddings，与嵌入同一地址）----------
VECTOR_URL=https://11435.tdx1146.cc/v1/embeddings

# ---------- 做梦调度 ----------
DREAM_IDLE_THRESHOLD=300
DREAM_STEPS=30
DREAM_CHECK_INTERVAL=10
# 自指回路（测试期可开，日常保持 false）
LMS_SELF_REF_ENABLED=false
