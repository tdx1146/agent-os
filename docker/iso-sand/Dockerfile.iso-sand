# ============================================================================
# Agent OS Docker 化 — iso-sand 事件总线（Phase 7）
# ----------------------------------------------------------------------------
# 运行 scheduler + consumer 两个进程（由 /docker/iso-sand/launcher.py 拉起）。
# 代码（src/）与配置（deploy/）由 compose 以只读方式挂载 /app/iso-sand，
# 数据目录（event_bus.jsonl 等）由 compose 挂载（默认宿主真实 data/，
# 沙箱验证时可指向 verify-data/iso-sand-data/）。
# 第三方依赖：
#   PyYAML  -- event_consumer / task_scheduler 解析 rules/tasks.yaml
#   croniter -- task_scheduler._is_time_to_run 的 cron 表达式计算
# ============================================================================

FROM python:3.11-slim

LABEL org.opencontainers.image.title="agentos-iso-sand" \
      org.opencontainers.image.description="iso-sand 事件总线（scheduler+consumer 双进程，容器版）" \
      org.opencontainers.image.version="1.1.0"

RUN pip install --no-cache-dir pyyaml croniter

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# launcher 与沙箱 tasks 由 compose 挂载（./iso-sand -> /docker/iso-sand）
CMD ["python", "/docker/iso-sand/launcher.py"]
